<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Juan's Mechanic Shop | 24/7 Roadside Assistance</title>
<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f4f4f4;
    color:#333;
}

header{
    background:#111;
    color:#fff;
    position:fixed;
    width:100%;
    top:0;
    z-index:1000;
    box-shadow:0 3px 8px rgba(0,0,0,.3);
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

nav{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 0;
}

.logo{
    font-size:30px;
    font-weight:bold;
    color:#FFD700;
}

nav ul{
    display:flex;
    list-style:none;
}

nav ul li{
    margin-left:25px;
}

nav ul li a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

nav ul li a:hover{
    color:#FFD700;
}

.hero{
    background:
    linear-gradient(rgba(0,0,0,.7),rgba(0,0,0,.7)),
    url("https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1600&q=80");
    background-size:cover;
    background-position:center;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:white;
    padding:20px;
}

.hero h1{
    font-size:60px;
}

.hero p{
    font-size:24px;
    margin:20px 0;
}

.btn{
    display:inline-block;
    background:#FFD700;
    color:#111;
    padding:15px 35px;
    border-radius:5px;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
}

.btn:hover{
    background:white;
}

section{
    padding:90px 20px;
}

.title{
    text-align:center;
    margin-bottom:50px;
    font-size:40px;
}

.services{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.service{
    background:white;
    padding:30px;
    border-radius:10px;
    box-shadow:0 8px 20px rgba(0,0,0,.1);
    text-align:center;
}

.service h3{
    color:#d89a00;
    margin:15px 0;
}

.about{
    max-width:900px;
    margin:auto;
    text-align:center;
    font-size:18px;
    line-height:1.8;
}

.contact{
    background:#111;
    color:white;
    text-align:center;
}

.contact h2{
    color:#FFD700;
}

.phone{
    font-size:40px;
    color:#FFD700;
    margin:20px 0;
    font-weight:bold;
}

.hours{
    font-size:22px;
}

footer{
    background:#000;
    color:white;
    text-align:center;
    padding:20px;
}

@media(max-width:700px){

.hero h1{
font-size:38px;
}

.hero p{
font-size:20px;
}

nav{
flex-direction:column;
}

nav ul{
margin-top:15px;
}

nav ul li{
margin:10px;
}

}
</style>
</head>
<body>
<header>
